# ESP-IDF build output — huge and machine-specific. Untracked (removed from the index
# with `git rm -r --cached build`); regenerated locally by idf.py. Keep it ignored.
/build/

# Component-manager-fetched deps for the root project — fully regenerable from
# idf_component.yml + dependencies.lock. Untracked (removed from the index with
# `git rm -r --cached managed_components`), matching the c6_slave/ precedent below.
/managed_components/

# C6 slave firmware (c6_slave/) is a second IDF project (esp32c6). Track its sources,
# but ignore per-machine generated artefacts: build output, the sdkconfig generated
# from sdkconfig.defaults, and component-manager-fetched deps.
c6_slave/slave/build/
c6_slave/slave/sdkconfig
c6_slave/slave/sdkconfig.old
c6_slave/slave/managed_components/
c6_slave/slave/dependencies.lock

# Scratch screenshots from the dev loop (tools/prop.py, tools/screenshot.py).
# Firmware images are C arrays in main/*.c, never .png — so every .png here is scratch.
*.png
!docs/design/screens/*.png

# Python bytecode cache from the dev tools.
__pycache__/

# Local WiFi secret: SSID/password baked in as the build-time STA default (used only
# when NVS has no stored creds). Machine-specific, NOT for the repo. The committed
# wifi_secret.env.example is the template; copy it to wifi_secret.env and fill it in.
wifi_secret.env

# VS Code "Local History" extension backups — editor-generated, not project content.
.history/
