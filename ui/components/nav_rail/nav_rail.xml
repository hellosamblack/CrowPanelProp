<!--
  nav_rail — the persistent 76px icon rail down the left edge of every screen.
  Mirrors the s_rail[] table + build_rail() in main/prop_ui.c (CONSOLE / ARCHIVE /
  INSTRUMENTS / SENSORS / CASSETTE / INSIGHTS / SETUP).

  In the firmware the rail is drawn from LVGL primitives and navigates via
  open_panel(); here each cell is a clickable button that fires a
  screen_create_event so the rail navigates live in the editor preview.
  (screen_create_event = build-on-enter / delete-on-leave, matching the firmware's
  lazily-built one-panel-at-a-time model.)

  Included by every screen as <nav_rail/> in place of the old static placeholder.
-->
<component>
    <styles>
        <style name="strip"
               bg_color="#col_panel_item"
               border_side="right" border_color="#col_dim" border_width="2"
               radius="0" pad_all="0" />
        <style name="cell"
               bg_opa="0" border_width="0" radius="0" shadow_width="0"
               text_color="#col_mute" text_font="font_body"
               width="76" height="85" />
        <!-- Pressed feedback: dim amber wash -->
        <style name="cell_pr" bg_color="#col_dim" bg_opa="120" />
    </styles>

    <view width="76" height="600" align="top_left" flex_flow="column">
        <style name="strip" />

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="CONSOLE" align="center" />
            <screen_create_event screen="screen_home" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="ARCHIVE" align="center" />
            <screen_create_event screen="screen_archive" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="INSTR" align="center" />
            <screen_create_event screen="screen_instruments" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="SENSORS" align="center" />
            <screen_create_event screen="screen_sensors" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="CASS" align="center" />
            <screen_create_event screen="screen_cassette" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="INSIGHT" align="center" />
            <screen_create_event screen="screen_insights" trigger="clicked" />
        </lv_button>

        <lv_button>
            <style name="cell" /><style name="cell_pr" selector="pressed" />
            <lv_label text="SETUP" align="center" />
            <screen_create_event screen="screen_setup" trigger="clicked" />
        </lv_button>
    </view>
</component>
