<!--
  nav_rail — the persistent 76px rail down the left edge of every screen.
  Mirrors the s_rail[] table + build_rail() in main/prop_ui.c (CONSOLE / ARCHIVE /
  INSTRUMENTS / SENSORS / CASSETTE / INSIGHTS / SETUP).

  Each cell is a clickable button that fires a screen_create_event, so the rail
  navigates live in the editor preview (screen_create_event = build-on-enter /
  delete-on-leave, matching the firmware's lazily-built one-panel model).

  Structure follows the proven container-component pattern (lvgl_editor
  tutorials/8_animations list.xml): the view is sized with element attributes and
  styled with inline style_* props; each cell button is sized with width/height
  attributes (NOT via a named style, which isn't honored for flex-child geometry).
  Included by every screen as <nav_rail/>.
-->
<component>
    <view
        width="76" height="600"
        flex_flow="column"
        style_bg_color="#col_panel_item"
        style_border_side="right"
        style_border_color="#col_dim"
        style_border_width="2"
        style_radius="0"
        style_pad_all="0"
        style_pad_row="0"
    >
        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="CONSOLE" align="center" />
            <screen_create_event screen="screen_home" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="ARCHIVE" align="center" />
            <screen_create_event screen="screen_archive" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="INSTR" align="center" />
            <screen_create_event screen="screen_instruments" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="SENSORS" align="center" />
            <screen_create_event screen="screen_sensors" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="CASS" align="center" />
            <screen_create_event screen="screen_cassette" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="INSIGHT" align="center" />
            <screen_create_event screen="screen_insights" trigger="clicked" />
        </lv_button>

        <lv_button width="76" height="85"
                   style_bg_opa="0" style_bg_color-pressed="#col_dim" style_bg_opa-pressed="140"
                   style_border_width="0" style_radius="0" style_shadow_width="0"
                   style_text_color="#col_mute" style_text_font="font_body">
            <lv_label text="SETUP" align="center" />
            <screen_create_event screen="screen_setup" trigger="clicked" />
        </lv_button>
    </view>
</component>
