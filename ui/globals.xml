    <consts>
        <!-- Cassette-futurism amber palette — mirrors prop_kit.h COL_* -->
        <color name="col_bg"         value="0x0A0A06" />
        <color name="col_amber"      value="0xE0B000" />
        <color name="col_mute"       value="0xB58A00" />
        <color name="col_dim"        value="0x6B5300" />
        <color name="col_alert"      value="0xFF3030" />
        <color name="col_panel_item" value="0x141008" />
