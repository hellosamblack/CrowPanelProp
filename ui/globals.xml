    <fonts>
        <!-- tiny_ttf = loaded dynamically from file; required for the online viewer.
             bin (compile-time C arrays) is firmware-only and cannot be used here. -->
        <tiny_ttf name="font_body"   size="14" as_file="true" src_path="fonts/Eurostile-Bold.ttf" />
        <tiny_ttf name="font_head"   size="24" as_file="true" src_path="fonts/Eurostile-Bold.ttf" />
        <tiny_ttf name="font_status" size="40" as_file="true" src_path="fonts/Eurostile-Bold.ttf" />
