<!--
  ABOUT panel — firmware identity + live telemetry (IP / uptime updated by observer).
  Mirrors build_about_panel() in main/prop_ui.c.

  The card is kit_card: COL_PANEL_ITEM bg (+ phosphor gradient), dim border, flex column.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="card"
               bg_color="#col_panel_item"
               bg_grad_color="#col_bg"
               bg_grad_dir="ver"
               bg_opa="255"
               border_color="#col_dim" border_width="1" radius="0"
               pad_all="14" />
    </styles>

    <view style_bg_color="#col_bg">

        <lv_obj width="76" height="600" align="top_left"
                style_bg_color="#col_panel_item" style_border_width="0" style_radius="0" style_pad_all="0" />

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <lv_label text="ABOUT" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- kit_card — identity info rows -->
            <lv_obj width="848" height="content" align="top_mid" y="92">
                <style name="card" />
                <column width="100%" style_bg_opa="0" style_border_width="0" style_pad_row="10">

                    <!-- kit_info_row: muted key left, amber value right -->
                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="UNIT"     align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="COMM // SCANNER UNIT-7" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="FIRMWARE" align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="0.5.0"    align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="BUILD"    align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="Jun 21 2026  12:00:00" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="IDF"      align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="v6.0.1-dirty" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="IP"       align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label bind_text="subj_ip" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="UPTIME"   align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label bind_text="subj_uptime" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                </column>
            </lv_obj>

        </lv_obj>
    </view>
</screen>
