<!--
  AUDIO settings — volume slider, mute toggle, placeholder note.
  Mirrors build_audio_panel() in main/prop_ui.c.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="lbl"      text_color="#col_amber" text_font="font_body" />
        <style name="mute"     text_color="#col_mute"  text_font="font_body" />
        <!-- Slider parts (referenced with selector=) -->
        <style name="sld_main" bg_color="#col_panel_item" bg_opa="255" border_color="#col_dim" border_width="1" radius="0" />
        <style name="sld_ind"  bg_color="#col_amber" radius="0" />
        <style name="sld_knob" bg_color="#col_amber" radius="0" />
        <!-- Switch parts -->
        <style name="sw_main" bg_color="#col_panel_item" border_color="#col_dim" border_width="1" radius="0" />
        <style name="sw_ind"  bg_color="#col_amber" radius="0" />
        <style name="sw_knob" bg_color="#col_amber" radius="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <lv_obj width="76" height="600" align="top_left"
                style_bg_color="#col_panel_item" style_border_width="0" style_radius="0" style_pad_all="0" />

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <lv_label text="AUDIO" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- VOLUME slider row -->
            <lv_label text="VOLUME" align="top_left"  x="40" y="82"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_volume" bind_text-fmt="%d%%" align="top_right" x="-40" y="82"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="104" bind_value="subj_volume" min="0" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- MUTE switch row -->
            <lv_label text="MUTE" align="top_left" x="40" y="154"><style name="lbl" /></lv_label>
            <lv_switch align="top_right" x="-40" y="148" bind_checked="subj_mute"><style name="sw_main" /><style name="sw_ind" selector="checked|indicator" /><style name="sw_knob" selector="knob" /></lv_switch>

            <!-- Note -->
            <lv_label text="Output stage idle - SFX not yet wired."
                      align="top_left" x="40" y="206">
                <style name="mute" />
            </lv_label>

        </lv_obj>
    </view>
</screen>
