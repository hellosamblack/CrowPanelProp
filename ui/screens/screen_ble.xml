<!--
  CONTACTS instrument — passive BLE scan rendered as ranged contacts.
  Mirrors build_ble_panel() in main/prop_ui.c.

  BLE_ROW_H = 64 px. Each row: name/class (top), dBm (top right),
  distance (right), classification sub-line (left), strength bar.
  Demo shows 4 contacts. Real list is rebuilt ~2.5 Hz by the observer.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="tag"      text_color="#col_amber" text_font="font_body" />
        <style name="sub"      text_color="#col_mute"  text_font="font_body" />
        <style name="meter_track" bg_color="#col_panel_item" bg_opa="255" border_color="#col_dim" border_width="2" radius="0" />
        <style name="meter_fill"  bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <style name="meter_dim"   bg_color="#col_dim"   bg_opa="255" border_width="0" radius="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_sensors" trigger="clicked" />
            </lv_button>

            <lv_label text="CONTACTS" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Summary header -->
            <lv_label text="4 CONTACTS DETECTED  //  -55 dBm" align="top_left" x="30" y="84"
                      style_text_color="#col_amber" style_text_font="font_head" />

            <!-- Contact list container (SCAN_W-60 wide, starting y=132) -->
            <lv_obj width="888" height="434" align="top_left" x="30" y="132"
                    style_bg_opa="0" style_border_width="0" style_pad_all="0">

                <!-- Contact 1 (y=0): Apple Watch -->
                <lv_label text="01  ZARRAH'S WATCH"   align="top_left"  x="6" y="0"><style name="tag" /></lv_label>
                <lv_label text="-55 dBm"              align="top_right" x="-6" y="0"><style name="sub" /></lv_label>
                <lv_label text="~ 1.2 m"              align="top_right" x="-6" y="22" style_text_color="#col_amber" style_text_font="font_body" />
                <lv_label text="CIVILIAN UNIT  //  Apple Inc" align="top_left" x="6" y="22"><style name="sub" /></lv_label>
                <lv_obj width="680" height="18" align="top_left" x="6" y="46">
                    <style name="meter_track" />
                    <lv_obj width="530" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
                </lv_obj>

                <!-- Contact 2 (y=64): Unknown phone -->
                <lv_label text="02  MOBILE HANDSET"   align="top_left"  x="6" y="64"><style name="tag" /></lv_label>
                <lv_label text="-68 dBm"              align="top_right" x="-6" y="64"><style name="sub" /></lv_label>
                <lv_label text="~ 3.8 m"              align="top_right" x="-6" y="86" style_text_color="#col_amber" style_text_font="font_body" />
                <lv_label text="CIVILIAN UNIT  //  Samsung Electronics" align="top_left" x="6" y="86"><style name="sub" /></lv_label>
                <lv_obj width="680" height="18" align="top_left" x="6" y="110">
                    <style name="meter_track" />
                    <lv_obj width="365" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
                </lv_obj>

                <!-- Contact 3 (y=128): Anonymous beacon -->
                <lv_label text="03  ANONYMOUS BEACON" align="top_left"  x="6" y="128"><style name="tag" /></lv_label>
                <lv_label text="-79 dBm"              align="top_right" x="-6" y="128"><style name="sub" /></lv_label>
                <lv_label text="~ 9 m"                align="top_right" x="-6" y="150" style_text_color="#col_amber" style_text_font="font_body" />
                <lv_label text="ANONYMOUS BEACON" align="top_left" x="6" y="150"><style name="sub" /></lv_label>
                <lv_obj width="680" height="18" align="top_left" x="6" y="174">
                    <style name="meter_track" />
                    <lv_obj width="196" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
                </lv_obj>

                <!-- Contact 4 (y=192): Weak unknown emitter -->
                <lv_label text="04  5C:F7:E6:11:22:33" align="top_left"  x="6" y="192"><style name="tag" /></lv_label>
                <lv_label text="-91 dBm"               align="top_right" x="-6" y="192"><style name="sub" /></lv_label>
                <lv_label text="~ 24 m"                align="top_right" x="-6" y="214" style_text_color="#col_amber" style_text_font="font_body" />
                <lv_label text="UNKNOWN EMITTER" align="top_left" x="6" y="214"><style name="sub" /></lv_label>
                <lv_obj width="680" height="18" align="top_left" x="6" y="238">
                    <style name="meter_track" />
                    <lv_obj width="50" height="10" align="left_mid" x="0" y="0"><style name="meter_dim" /></lv_obj>
                </lv_obj>

            </lv_obj>

        </lv_obj>
    </view>
</screen>
