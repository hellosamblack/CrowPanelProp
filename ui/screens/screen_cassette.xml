<!--
  CASSETTE deck — decorative transport panel (stub; playback not yet wired).
  Mirrors build_cassette_panel() in main/prop_ui.c.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="reel"     bg_color="#col_panel_item" border_color="#col_amber" border_width="3" radius="100" />
        <style name="xport"    bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_head" shadow_width="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_home" trigger="clicked" />
            </lv_button>

            <lv_label text="CASSETTE" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Left reel -->
            <lv_obj width="120" height="120" align="top_mid" x="-170" y="120">
                <style name="reel" />
            </lv_obj>

            <!-- Right reel -->
            <lv_obj width="120" height="120" align="top_mid" x="170" y="120">
                <style name="reel" />
            </lv_obj>

            <!-- Counter -->
            <lv_label text="0 0 0 0" align="top_mid" y="150"
                      style_text_color="#col_amber" style_text_font="font_head" />

            <!-- Transport buttons: |&lt;  &gt;  []  &gt;| -->
            <lv_button width="90" height="44" align="top_mid" x="-150" y="300">
                <style name="xport" /><lv_label text="|&lt;" />
            </lv_button>
            <lv_button width="90" height="44" align="top_mid" x="-50" y="300">
                <style name="xport" /><lv_label text="&gt;" />
            </lv_button>
            <lv_button width="90" height="44" align="top_mid" x="50" y="300">
                <style name="xport" /><lv_label text="[]" />
            </lv_button>
            <lv_button width="90" height="44" align="top_mid" x="150" y="300">
                <style name="xport" /><lv_label text="&gt;|" />
            </lv_button>

            <!-- Status -->
            <lv_label text="NO CASSETTE LOADED" align="bottom_mid" y="-70"
                      style_text_color="#col_mute" style_text_font="font_head" />

            <lv_label text="Transport idle - playback not yet wired to the audio stage."
                      align="bottom_mid" y="-34"
                      style_text_color="#col_mute" style_text_font="font_body" />

        </lv_obj>
    </view>
</screen>
