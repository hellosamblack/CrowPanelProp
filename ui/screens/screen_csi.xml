<!--
  SIGNAL ENV instrument — per-subcarrier WiFi channel amplitude (32 bars).
  Mirrors build_csi_panel() in main/prop_ui.c.

  Constants: CSI_BW=20 CSI_GAP=8 CSI_X0=30 CSI_BASE=118 CSI_MAXH=300
  Bar i: x = 30 + i*28, height varies 0..300, anchored bottom_left y=-118.
  Demo data shows a typical multipath fading pattern (sinusoidal envelope across
  subcarriers — synthetic fallback on this esp_hosted stack; labelled SYNTHETIC).
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="bar"      bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <style name="baseline" bg_color="#col_dim"   bg_opa="255" border_width="0" radius="0" />
        <style name="mute"     text_color="#col_mute" text_font="font_body" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_sensors" trigger="clicked" />
            </lv_button>

            <lv_label text="SIGNAL ENV" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Status label -->
            <lv_label text="SIGNAL ENV ACTIVE  //  SYNTHETIC" align="top_left" x="30" y="84"
                      style_text_color="#col_amber" style_text_font="font_head" />

            <!-- Baseline: 32*20 + 31*8 = 640+248 = 888 wide, at x=30 -->
            <lv_obj width="888" height="2" align="bottom_left" x="30" y="-116">
                <style name="baseline" />
            </lv_obj>

            <!-- 32 CSI bars. x = 30 + i*28. Heights show multipath fading envelope -->
            <lv_obj width="20" height="85"  align="bottom_left" x="30"  y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="125" align="bottom_left" x="58"  y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="180" align="bottom_left" x="86"  y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="225" align="bottom_left" x="114" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="200" align="bottom_left" x="142" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="165" align="bottom_left" x="170" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="130" align="bottom_left" x="198" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="95"  align="bottom_left" x="226" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="65"  align="bottom_left" x="254" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="85"  align="bottom_left" x="282" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="145" align="bottom_left" x="310" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="205" align="bottom_left" x="338" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="255" align="bottom_left" x="366" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="245" align="bottom_left" x="394" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="185" align="bottom_left" x="422" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="125" align="bottom_left" x="450" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="90"  align="bottom_left" x="478" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="120" align="bottom_left" x="506" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="165" align="bottom_left" x="534" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="215" align="bottom_left" x="562" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="235" align="bottom_left" x="590" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="200" align="bottom_left" x="618" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="155" align="bottom_left" x="646" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="105" align="bottom_left" x="674" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="72"  align="bottom_left" x="702" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="92"  align="bottom_left" x="730" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="135" align="bottom_left" x="758" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="185" align="bottom_left" x="786" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="215" align="bottom_left" x="814" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="195" align="bottom_left" x="842" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="145" align="bottom_left" x="870" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="20" height="92"  align="bottom_left" x="898" y="-118"><style name="bar" /></lv_obj>

            <!-- Note -->
            <lv_label text="WiFi channel state  -  per-subcarrier amplitude"
                      align="bottom_left" x="30" y="-30">
                <style name="mute" />
            </lv_label>

        </lv_obj>
    </view>
</screen>
