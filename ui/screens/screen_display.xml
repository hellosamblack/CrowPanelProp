<!--
  DISPLAY settings — backlight + CRT effect sliders + transition picker + FPS toggle.
  Mirrors build_display_panel() in main/prop_ui.c.

  Uses kit_body layout: flex column, top_mid y=76, pad_row=18.
  Slider rows: label+value header, then full-width slider.
  Switch rows: label on left, switch on right (space-between).
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="lbl"      text_color="#col_amber" text_font="font_body" />
        <style name="mute"     text_color="#col_mute"  text_font="font_body" />
        <!-- Slider parts (referenced with selector=) -->
        <style name="sld_main" bg_color="#col_panel_item" bg_opa="255" border_color="#col_dim" border_width="1" radius="0" />
        <style name="sld_ind"  bg_color="#col_amber" radius="0" />
        <style name="sld_knob" bg_color="#col_amber" radius="0" />
        <!-- Switch parts -->
        <style name="sw_main" bg_color="#col_panel_item" border_color="#col_dim" border_width="1" radius="0" />
        <style name="sw_ind"  bg_color="#col_amber" radius="0" />
        <style name="sw_knob" bg_color="#col_amber" radius="0" />
        <style name="field"    bg_color="#col_panel_item" border_color="#col_dim" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_setup" trigger="clicked" />
            </lv_button>

            <lv_label text="DISPLAY" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- kit_body: flex column starting below header -->
            <!-- BACKLIGHT slider row  y≈76 -->
            <lv_label text="BACKLIGHT" align="top_left" x="40" y="82"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_brightness" bind_text-fmt="%d%%" align="top_right" x="-40" y="82"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="104" bind_value="subj_brightness" min="5" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- CRT EFFECTS switch row  y≈148 -->
            <lv_label text="CRT EFFECTS" align="top_left" x="40" y="154"><style name="lbl" /></lv_label>
            <lv_switch align="top_right" x="-40" y="148" bind_checked="subj_fx_on"><style name="sw_main" /><style name="sw_ind" selector="checked|indicator" /><style name="sw_knob" selector="knob" /></lv_switch>

            <!-- SCANLINES slider row  y≈196 -->
            <lv_label text="SCANLINES" align="top_left" x="40" y="196"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_scanlines" bind_text-fmt="%d%%" align="top_right" x="-40" y="196"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="218" bind_value="subj_scanlines" min="0" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- PHOSPHOR slider row  y≈262 -->
            <lv_label text="PHOSPHOR" align="top_left" x="40" y="262"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_phosphor" bind_text-fmt="%d%%" align="top_right" x="-40" y="262"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="284" bind_value="subj_phosphor" min="0" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- VIGNETTE slider row  y≈328 -->
            <lv_label text="VIGNETTE" align="top_left" x="40" y="328"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_vignette" bind_text-fmt="%d%%" align="top_right" x="-40" y="328"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="350" bind_value="subj_vignette" min="0" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- REFRESH SWEEP slider row  y≈394 -->
            <lv_label text="REFRESH SWEEP" align="top_left" x="40" y="394"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_refresh" bind_text-fmt="%d%%" align="top_right" x="-40" y="394"><style name="mute" /></lv_label>
            <lv_slider width="868" height="22" align="top_mid" y="416" bind_value="subj_refresh" min="0" max="100">
                <style name="sld_main" /><style name="sld_ind" selector="indicator" /><style name="sld_knob" selector="knob" />
            </lv_slider>

            <!-- TRANSITION dropdown row  y≈460 -->
            <lv_label text="TRANSITION" align="top_left" x="40" y="466"><style name="lbl" /></lv_label>
            <lv_dropdown width="360" align="top_right" x="-40" y="456"
                         options="OFF&#10;SNOW&#10;ROLL&#10;COLLAPSE&#10;SNOW+COLLAPSE" bind_value="subj_transition">
                <style name="field" />
            </lv_dropdown>

            <!-- FPS METER switch row  y≈516 -->
            <lv_label text="FPS METER" align="top_left" x="40" y="520"><style name="lbl" /></lv_label>
            <lv_switch align="top_right" x="-40" y="514" bind_checked="subj_fps_on"><style name="sw_main" /><style name="sw_ind" selector="checked|indicator" /><style name="sw_knob" selector="knob" /></lv_switch>

        </lv_obj>
    </view>
</screen>
