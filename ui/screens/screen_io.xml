<!--
  I/O BENCH overview — every pin as a box on one page (number inside, state-coloured).
  Mirrors build_io_panel() in main/prop_ui.c.

  Grid: IO_COLS=6, IO_BOX_W=143, IO_BOX_H=150, IO_GAP=10, 3 rows. Flex row-wrap,
  centred under the title (top_mid, y=76). Border encodes direction (thin muted = input,
  thick amber = output); digital boxes light amber when HIGH; analog boxes fill from the
  bottom. Tapping a box opens its single-pin config page.

  Pin set + states here are representative (the real list comes from bsp_aio).
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <!-- Input box: thin muted border, panel fill, muted text -->
        <style name="box_in"   bg_color="#col_panel_item" border_color="#col_mute"  border_width="2" radius="0" pad_all="0" />
        <!-- Output box: thick amber border -->
        <style name="box_out"  bg_color="#col_panel_item" border_color="#col_amber" border_width="4" radius="0" pad_all="0" />
        <!-- Digital HIGH box: amber fill, dark text -->
        <style name="box_hi"   bg_color="#col_amber"      border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="num_amber" text_color="#col_amber" text_font="font_status" />
        <style name="num_mute"  text_color="#col_mute"  text_font="font_status" />
        <style name="num_dark"  text_color="#col_bg"    text_font="font_status" />
        <style name="sub_amber" text_color="#col_amber" text_font="font_body" />
        <style name="sub_mute"  text_color="#col_mute"  text_font="font_body" />
        <style name="sub_dark"  text_color="#col_bg"    text_font="font_body" />
        <style name="afill"    bg_color="#col_dim" bg_opa="255" border_width="0" radius="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <lv_obj width="76" height="600" align="top_left"
                style_bg_color="#col_panel_item" style_border_width="0" style_radius="0" style_pad_all="0" />

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <lv_label text="I/O BENCH" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Pin grid: 6 wide, flex row-wrap, gap 10, centred -->
            <lv_obj width="908" height="470" align="top_mid" y="76" flex_flow="row_wrap"
                    style_pad_column="10" style_pad_row="10"
                    style_bg_opa="0" style_border_width="0" style_pad_all="0">

                <!-- Row 1 -->
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="01" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_hi" />
                    <lv_label text="02" align="center" y="-10"><style name="num_dark" /></lv_label>
                    <lv_label text="HI" align="bottom_mid" y="-8"><style name="sub_dark" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_out" />
                    <lv_label text="03" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="04" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <!-- Analog-in box with partial fill -->
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_obj width="100%" height="90" align="bottom_mid"><style name="afill" /></lv_obj>
                    <lv_label text="05" align="center" y="-10"><style name="num_amber" /></lv_label>
                    <lv_label text="61%" align="bottom_mid" y="-8"><style name="sub_amber" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="06" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>

                <!-- Row 2 -->
                <lv_obj width="143" height="150"><style name="box_out" />
                    <lv_label text="07" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_hi" />
                    <lv_label text="08" align="center" y="-10"><style name="num_dark" /></lv_label>
                    <lv_label text="HI" align="bottom_mid" y="-8"><style name="sub_dark" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="09" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <!-- Analog-out box with partial fill -->
                <lv_obj width="143" height="150"><style name="box_out" />
                    <lv_obj width="100%" height="50" align="bottom_mid"><style name="afill" /></lv_obj>
                    <lv_label text="10" align="center" y="-10"><style name="num_amber" /></lv_label>
                    <lv_label text="34%" align="bottom_mid" y="-8"><style name="sub_amber" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="11" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="12" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>

                <!-- Row 3 -->
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="13" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_out" />
                    <lv_label text="14" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_hi" />
                    <lv_label text="15" align="center" y="-10"><style name="num_dark" /></lv_label>
                    <lv_label text="HI" align="bottom_mid" y="-8"><style name="sub_dark" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="16" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>
                <lv_obj width="143" height="150"><style name="box_in" />
                    <lv_label text="17" align="center" y="-10"><style name="num_mute" /></lv_label>
                    <lv_label text="LO" align="bottom_mid" y="-8"><style name="sub_mute" /></lv_label>
                </lv_obj>

            </lv_obj>

        </lv_obj>
    </view>
</screen>
