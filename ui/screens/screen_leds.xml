<!--
  LEDS settings — per-lamp toggles and lamp test.
  Mirrors build_leds_panel() in main/prop_ui.c.
  LED_COUNT = 2: LED_POWER (GPIO48), LED_ALERT (GPIO20).
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="lbl"      text_color="#col_amber" text_font="font_body" />
        <style name="mute"     text_color="#col_mute"  text_font="font_body" />
        <!-- Switch parts (referenced with selector=) -->
        <style name="sw_main" bg_color="#col_panel_item" border_color="#col_dim" border_width="1" radius="0" />
        <style name="sw_ind"  bg_color="#col_amber" radius="0" />
        <style name="sw_knob" bg_color="#col_amber" radius="0" />
        <style name="test_btn" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_setup" trigger="clicked" />
            </lv_button>

            <lv_label text="LEDS" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- POWER switch row -->
            <lv_label text="POWER" align="top_left" x="40" y="100"><style name="lbl" /></lv_label>
            <lv_switch align="top_right" x="-40" y="94" bind_checked="subj_led_power"><style name="sw_main" /><style name="sw_ind" selector="checked|indicator" /><style name="sw_knob" selector="knob" /></lv_switch>

            <!-- ALERT switch row -->
            <lv_label text="ALERT" align="top_left" x="40" y="162"><style name="lbl" /></lv_label>
            <lv_switch align="top_right" x="-40" y="156" bind_checked="subj_led_alert"><style name="sw_main" /><style name="sw_ind" selector="checked|indicator" /><style name="sw_knob" selector="knob" /></lv_switch>

            <!-- LAMP TEST button -->
            <lv_button width="200" height="52" align="top_left" x="40" y="218">
                <style name="test_btn" /><lv_label text="LAMP TEST" />
            </lv_button>

            <!-- Note -->
            <lv_label text="Lamps are on/off (no brightness). Scene animation resumes control."
                      align="top_left" x="40" y="288">
                <style name="mute" />
            </lv_label>

        </lv_obj>
    </view>
</screen>
