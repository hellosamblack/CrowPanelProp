<!--
  RF BAND instrument — 2.4 GHz channel-occupancy bar chart (13 channels).
  Mirrors build_rfband_panel() in main/prop_ui.c.

  Constants: RF_BW=42 RF_GAP=20 RF_X0=82 RF_BASE=130 RF_MAXH=300
  Bar i: x = 82 + i*62, height varies 0..300, anchored bottom_left y=-130.
  Demo: channels 1, 6, 11 are heavily occupied (common WiFi interference pattern).
  Baseline at bottom_left x=82 y=-128, width=13*42+12*20=786.
  Channel labels just below baseline.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="rescan"   bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="bar"      bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <style name="baseline" bg_color="#col_dim"   bg_opa="255" border_width="0" radius="0" />
        <style name="ch_lbl"   text_color="#col_mute" text_font="font_body" />
        <style name="mute"     text_color="#col_mute" text_font="font_body" />
    </styles>

    <view style_bg_color="#col_bg">

        <lv_obj width="76" height="600" align="top_left"
                style_bg_color="#col_panel_item" style_border_width="0" style_radius="0" style_pad_all="0" />

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <lv_label text="RF BAND" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Status label -->
            <lv_label text="3 EMITTERS  -  PEAK CH 1" align="top_left" x="30" y="84"
                      style_text_color="#col_amber" style_text_font="font_head" />

            <!-- RESCAN button -->
            <lv_button width="150" height="44" align="top_right" x="-30" y="78">
                <style name="rescan" /><lv_label text="RESCAN" />
            </lv_button>

            <!-- Baseline -->
            <lv_obj width="786" height="2" align="bottom_left" x="82" y="-128">
                <style name="baseline" />
            </lv_obj>

            <!-- 13 channel bars. x = 82 + i*62. Demo: CH1=185, CH6=220, CH11=200, rest low -->
            <lv_obj width="42" height="185" align="bottom_left" x="82"  y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="55"  align="bottom_left" x="144" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="30"  align="bottom_left" x="206" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="20"  align="bottom_left" x="268" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="15"  align="bottom_left" x="330" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="220" align="bottom_left" x="392" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="35"  align="bottom_left" x="454" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="18"  align="bottom_left" x="516" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="12"  align="bottom_left" x="578" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="8"   align="bottom_left" x="640" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="200" align="bottom_left" x="702" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="25"  align="bottom_left" x="764" y="-130"><style name="bar" /></lv_obj>
            <lv_obj width="42" height="12"  align="bottom_left" x="826" y="-130"><style name="bar" /></lv_obj>

            <!-- Channel number labels (below baseline): x = bar_x + RF_BW/2 - ~8 -->
            <lv_label text="1"  align="bottom_left" x="103" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="2"  align="bottom_left" x="165" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="3"  align="bottom_left" x="227" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="4"  align="bottom_left" x="289" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="5"  align="bottom_left" x="351" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="6"  align="bottom_left" x="413" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="7"  align="bottom_left" x="475" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="8"  align="bottom_left" x="537" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="9"  align="bottom_left" x="599" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="10" align="bottom_left" x="655" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="11" align="bottom_left" x="715" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="12" align="bottom_left" x="777" y="-112"><style name="ch_lbl" /></lv_label>
            <lv_label text="13" align="bottom_left" x="835" y="-112"><style name="ch_lbl" /></lv_label>

            <!-- Note -->
            <lv_label text="2.4 GHz channel occupancy  -  WiFi emitters per channel"
                      align="bottom_left" x="82" y="-30">
                <style name="mute" />
            </lv_label>

        </lv_obj>
    </view>
</screen>
