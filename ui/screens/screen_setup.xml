<!--
  SETUP panel — the settings menu (WI-FI / DISPLAY / AUDIO / LEDS / I/O BENCH / ABOUT).
  Mirrors build_menu_panel() in main/prop_ui.c.

  Layout: 76px nav-rail placeholder on left, 948×600 panel content on right.
  SCAN_W = 1024 - 76 = 948 (matches the firmware constant).
-->
<screen>
    <styles>
        <!-- Panel frame: dark fill, amber border, square corners -->
        <style name="panel"
               bg_color="#col_bg"
               border_color="#col_amber"
               border_width="2"
               radius="0"
               pad_all="0" />

        <!-- Header BACK button -->
        <style name="btn_back"
               bg_color="#col_panel_item"
               border_color="#col_amber"
               border_width="1"
               radius="0"
               text_color="#col_amber"
               text_font="font_body"
               shadow_width="0" />

        <!-- Panel title label -->
        <style name="title"
               text_color="#col_amber"
               text_font="font_head" />

        <!-- Full-width menu list row — kit_list_row equivalent -->
        <style name="list_row"
               width="100%"
               bg_color="#col_panel_item"
               border_width="0"
               radius="0"
               text_color="#col_amber"
               text_font="font_head"
               text_align="left"
               pad_left="20"
               pad_top="14"
               pad_bottom="14"
               shadow_width="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <!-- Nav rail placeholder (left 76 px) -->
        <lv_obj
            width="76" height="600"
            align="top_left"
            style_bg_color="#col_panel_item"
            style_border_width="0"
            style_radius="0"
            style_pad_all="0"
        />

        <!-- Panel content (right 948 px = SCAN_W) -->
        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <!-- BACK button (top-left, matches make_panel: x=20 y=12 w=130) -->
            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <!-- Title centred in header -->
            <lv_label text="SETUP" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- Menu items — kit_body + kit_list_row chain -->
            <column
                width="100%"
                align="top_left"
                y="70"
                style_pad_row="4"
                style_pad_hor="12"
                style_pad_top="0"
                style_pad_bottom="0"
                style_bg_opa="0"
                style_border_width="0"
            >
                <lv_button><style name="list_row" /><lv_label text="WI-FI" /></lv_button>
                <lv_button><style name="list_row" /><lv_label text="DISPLAY" /></lv_button>
                <lv_button><style name="list_row" /><lv_label text="AUDIO" /></lv_button>
                <lv_button><style name="list_row" /><lv_label text="LEDS" /></lv_button>
                <lv_button><style name="list_row" /><lv_label text="I/O BENCH" /></lv_button>
                <lv_button><style name="list_row" /><lv_label text="ABOUT" /></lv_button>
            </column>
        </lv_obj>

    </view>
</screen>
