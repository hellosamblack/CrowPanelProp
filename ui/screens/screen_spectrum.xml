<!--
  SPECTRUM instrument — live FFT bar chart (24 bars) + dB level meter + source selector.
  Mirrors build_spectrum_panel() in main/prop_ui.c.

  Constants: SPEC_BW=30 SPEC_GAP=8 SPEC_X0=52 SPEC_BASE=118 SPEC_MAXH=312
  Bar i: x = 52 + i*38, height varies 0..312, anchored bottom_left y=-118.
  Demo data: peaked distribution typical of microphone (A3/A4 region loudest).
  dB bar: SCAN_W-360 = 588px wide, starting at x=130, y=86.
  Source: [<] MIC [>] at bottom. Axis labels at BOTTOM_LEFT offsets.
-->
<screen>
    <styles>
        <style name="panel"     bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back"  bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"     text_color="#col_amber" text_font="font_head" />
        <style name="bar"       bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <style name="baseline"  bg_color="#col_dim"   bg_opa="255" border_width="0" radius="0" />
        <style name="lbl"       text_color="#col_amber" text_font="font_body" />
        <style name="mute"      text_color="#col_mute"  text_font="font_body" />
        <style name="dim_lbl"   text_color="#col_dim"   text_font="font_body" />
        <style name="meter_track" bg_color="#col_panel_item" bg_opa="255" border_color="#col_dim" border_width="2" radius="0" />
        <style name="meter_fill"  bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <style name="src_btn"   bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_head" shadow_width="0" />
    </styles>

    <view style_bg_color="#col_bg">

        <nav_rail/>

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            <screen_create_event screen="screen_instruments" trigger="clicked" />
            </lv_button>

            <lv_label text="SPECTRUM" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- dB level meter row -->
            <lv_label text="LEVEL" align="top_left" x="40" y="84"><style name="lbl" /></lv_label>
            <lv_label text="-18 dB" align="top_right" x="-40" y="84"><style name="mute" /></lv_label>
            <lv_obj width="588" height="18" align="top_left" x="130" y="86">
                <style name="meter_track" />
                <lv_obj width="370" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
            </lv_obj>

            <!-- Baseline at bottom_left y=-118 (= y position 482 from panel top) -->
            <!-- Baseline width: SCAN_W - 2*SPEC_X0 + SPEC_BW = 948-104+30 = 874 -->
            <lv_obj width="874" height="2" align="bottom_left" x="52" y="-116">
                <style name="baseline" />
            </lv_obj>

            <!-- FFT bars (24 bars). Each: width=30, align=bottom_left, x=52+i*38, y=-118 -->
            <!-- Heights (px) from demo data: peaked at bars 5-6 (~440-660 Hz) -->
            <lv_obj width="30" height="35"  align="bottom_left" x="52"  y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="78"  align="bottom_left" x="90"  y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="150" align="bottom_left" x="128" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="220" align="bottom_left" x="166" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="270" align="bottom_left" x="204" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="295" align="bottom_left" x="242" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="308" align="bottom_left" x="280" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="285" align="bottom_left" x="318" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="250" align="bottom_left" x="356" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="200" align="bottom_left" x="394" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="162" align="bottom_left" x="432" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="125" align="bottom_left" x="470" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="95"  align="bottom_left" x="508" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="70"  align="bottom_left" x="546" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="52"  align="bottom_left" x="584" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="40"  align="bottom_left" x="622" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="31"  align="bottom_left" x="660" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="24"  align="bottom_left" x="698" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="19"  align="bottom_left" x="736" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="14"  align="bottom_left" x="774" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="11"  align="bottom_left" x="812" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="8"   align="bottom_left" x="850" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="6"   align="bottom_left" x="888" y="-118"><style name="bar" /></lv_obj>
            <lv_obj width="30" height="4"   align="bottom_left" x="926" y="-118"><style name="bar" /></lv_obj>

            <!-- X-axis frequency labels (just below baseline, text centred on bar) -->
            <!-- Mic mode ticks: A2=110Hz(bar 1→x90), A3=220(bar 4→x204), A4=440(bar 7→x318), A5=880(bar 10→x432), A6=1760(bar 13→x546) -->
            <lv_label text="110&#10;A2" align="bottom_left" x="64"  y="-60" style_text_color="#col_dim" style_text_font="font_body" />
            <lv_label text="220&#10;A3" align="bottom_left" x="178" y="-60" style_text_color="#col_dim" style_text_font="font_body" />
            <lv_label text="440&#10;A4" align="bottom_left" x="292" y="-60" style_text_color="#col_dim" style_text_font="font_body" />
            <lv_label text="880&#10;A5" align="bottom_left" x="406" y="-60" style_text_color="#col_dim" style_text_font="font_body" />
            <lv_label text="1760&#10;A6" align="bottom_left" x="520" y="-60" style_text_color="#col_dim" style_text_font="font_body" />

            <!-- Source selector row at bottom: [&lt;]  MIC  [&gt;] -->
            <lv_button width="80" height="44" align="bottom_left" x="52" y="-14">
                <style name="src_btn" /><lv_label text="&lt;" />
            </lv_button>
            <lv_label text="MIC" align="bottom_mid" y="-22"
                      style_text_color="#col_amber" style_text_font="font_head" />
            <lv_button width="80" height="44" align="bottom_right" x="-52" y="-14">
                <style name="src_btn" /><lv_label text="&gt;" />
            </lv_button>

        </lv_obj>
    </view>
</screen>
