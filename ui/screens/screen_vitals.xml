<!--
  VITALS instrument — core temperature, RAM, battery cell, uptime + UPLINK dossier.
  Mirrors build_vitals_panel() in main/prop_ui.c.

  Each meter row: LABEL | VALUE on top, full-width 18 px meter bar below.
  Bar fill = orange/amber rectangle inside a COL_PANEL_ITEM track with a dim border.
  UPLINK dossier is a kit_card with NET / AP / LINK info rows.
-->
<screen>
    <styles>
        <style name="panel"    bg_color="#col_bg" border_color="#col_amber" border_width="2" radius="0" pad_all="0" />
        <style name="btn_back" bg_color="#col_panel_item" border_color="#col_amber" border_width="1" radius="0" text_color="#col_amber" text_font="font_body" shadow_width="0" />
        <style name="title"    text_color="#col_amber" text_font="font_head" />
        <style name="lbl"      text_color="#col_amber" text_font="font_body" />
        <style name="mute"     text_color="#col_mute"  text_font="font_body" />
        <!-- Meter bar track -->
        <style name="meter_track" bg_color="#col_panel_item" bg_opa="255" border_color="#col_dim" border_width="2" radius="0" />
        <!-- Meter fill -->
        <style name="meter_fill" bg_color="#col_amber" bg_opa="255" border_width="0" radius="0" />
        <!-- UPLINK card -->
        <style name="card" bg_color="#col_panel_item" bg_grad_color="#col_bg" bg_grad_dir="ver" bg_opa="255" border_color="#col_dim" border_width="1" radius="0" pad_all="14" />
    </styles>

    <view style_bg_color="#col_bg">

        <lv_obj width="76" height="600" align="top_left"
                style_bg_color="#col_panel_item" style_border_width="0" style_radius="0" style_pad_all="0" />

        <lv_obj width="948" height="600" align="top_right">
            <style name="panel" />

            <lv_button width="130" height="40" align="top_left" x="20" y="12">
                <style name="btn_back" />
                <lv_label text="&lt; BACK" />
            </lv_button>

            <lv_label text="VITALS" align="top_mid" y="18">
                <style name="title" />
            </lv_label>

            <!-- CORE TEMP meter row (y=82) -->
            <lv_label text="CORE TEMP" align="top_left"  x="40" y="82"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_core_temp" bind_text-fmt="%d C" align="top_right" x="-40" y="82"><style name="mute" /></lv_label>
            <lv_obj width="868" height="18" align="top_mid" y="102">
                <style name="meter_track" />
                <lv_obj width="355" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
            </lv_obj>

            <!-- FREE RAM meter row (y=138) -->
            <lv_label text="FREE RAM"  align="top_left"  x="40" y="138"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_free_ram" bind_text-fmt="%d KB" align="top_right" x="-40" y="138"><style name="mute" /></lv_label>
            <lv_obj width="868" height="18" align="top_mid" y="158">
                <style name="meter_track" />
                <lv_obj width="277" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
            </lv_obj>

            <!-- CELL meter row (y=194) -->
            <lv_label text="CELL"      align="top_left"  x="40" y="194"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_cell" bind_text-fmt="%d%%" align="top_right" x="-40" y="194"><style name="mute" /></lv_label>
            <lv_obj width="868" height="18" align="top_mid" y="214">
                <style name="meter_track" />
                <lv_obj width="608" height="10" align="left_mid" x="0" y="0"><style name="meter_fill" /></lv_obj>
            </lv_obj>

            <!-- UPTIME row (y=250, no bar) -->
            <lv_label text="UPTIME"    align="top_left"  x="40" y="250"><style name="lbl" /></lv_label>
            <lv_label bind_text="subj_uptime" align="top_right" x="-40" y="250"><style name="mute" /></lv_label>

            <!-- UPLINK section header -->
            <lv_label text="UPLINK" align="top_left" x="40" y="292"
                      style_text_color="#col_amber" style_text_font="font_head" />

            <!-- UPLINK card -->
            <lv_obj width="868" height="content" align="top_mid" y="326">
                <style name="card" />
                <column width="100%" style_bg_opa="0" style_border_width="0" style_pad_row="10">

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="NET"  align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="HOME-NETWORK" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="AP"   align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="7C:D9:5C:12:34:56" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                    <lv_obj width="100%" height="content" style_bg_opa="0" style_border_width="0">
                        <lv_label text="LINK" align="left_mid" style_text_color="#col_mute" style_text_font="font_body" />
                        <lv_label text="-67 dBm" align="right_mid" style_text_color="#col_amber" style_text_font="font_body" />
                    </lv_obj>

                </column>
            </lv_obj>

        </lv_obj>
    </view>
</screen>
